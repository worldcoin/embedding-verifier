# syntax=docker/dockerfile:1
# Carrier image that launches an enclave EIF on Nitro-enabled nodes.
#
# This consumes an EIF, it does not produce one — scripts/build-eif.sh does that,
# by handing the enclave image to `nitro-cli build-enclave`. What this packages is
# the already-built artifact plus the nitro-cli that runs it, because an enclave
# cannot be scheduled directly: `nitro-cli run-enclave` has to be called from the
# parent instance, so something ordinary has to own the enclave's lifecycle.
#
# Build context: the output dir of scripts/build-eif.sh (default target/eif/), so
# EIF_FILE is a bare filename in that directory.
#
# One carrier Dockerfile for every workload — the EIF is the only thing that
# differs. It is baked in at build time, so each workload gets its own image and
# the image digest covers the artifact whose PCRs clients attest:
#   docker build -f scripts/Dockerfile.carrier --build-arg EIF_FILE=di-enclave.eif target/eif

FROM public.ecr.aws/amazonlinux/amazonlinux:2023

RUN dnf install -y aws-nitro-enclaves-cli aws-nitro-enclaves-cli-devel jq && \
    dnf clean all

ARG EIF_FILE=deepface-enclave.eif
COPY ${EIF_FILE} /home/enclave.eif

# ENCLAVE_CID is unset by default (auto-assigned CID). Set it to pin the
# enclave's vsock CID so a co-located client can address it statically.
ENV EIF_PATH="/home/enclave.eif" \
    ENCLAVE_CPU_COUNT=2 \
    ENCLAVE_MEMORY_SIZE=1024 \
    ENCLAVE_DEBUG_MODE=false

COPY <<'EOF' /home/run.sh
#!/bin/bash
set -euo pipefail

CID_FLAG=""
if [[ -n "${ENCLAVE_CID:-}" ]]; then
    CID_FLAG="--enclave-cid ${ENCLAVE_CID}"
fi

DEBUG_FLAG=""
if [[ "${ENCLAVE_DEBUG_MODE}" == "true" || "${ENCLAVE_DEBUG_MODE}" == "1" ]]; then
    DEBUG_FLAG="--debug-mode"
fi

echo "[run.sh] Starting enclave: eif=${EIF_PATH} cid=${ENCLAVE_CID:-auto} cpu=${ENCLAVE_CPU_COUNT} mem=${ENCLAVE_MEMORY_SIZE}MiB debug=${ENCLAVE_DEBUG_MODE}"
nitro-cli run-enclave \
    --eif-path   "${EIF_PATH}" \
    --cpu-count  "${ENCLAVE_CPU_COUNT}" \
    --memory     "${ENCLAVE_MEMORY_SIZE}" \
    ${CID_FLAG} \
    ${DEBUG_FLAG}

enclave_id=$(nitro-cli describe-enclaves | jq -r '.[0].EnclaveID')
echo "[run.sh] Enclave started: ${enclave_id}"

# In debug mode, stream the enclave console to stdout (best-effort).
if [[ "${ENCLAVE_DEBUG_MODE}" == "true" || "${ENCLAVE_DEBUG_MODE}" == "1" ]]; then
    nitro-cli console --enclave-id "${enclave_id}" &
fi

# Keep the container alive; exit non-zero (restart the pod) if the enclave dies.
while nitro-cli describe-enclaves | jq -e '.[0].State == "RUNNING"' >/dev/null 2>&1; do
    sleep 15
done
echo "[run.sh] Enclave ${enclave_id} no longer running — exiting to trigger restart"
exit 1
EOF

RUN chmod +x /home/run.sh

CMD ["/home/run.sh"]
